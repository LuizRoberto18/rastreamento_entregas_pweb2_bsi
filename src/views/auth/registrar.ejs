<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastro | Rastreamento de Entregas</title>
  <style>
    body {
      margin: 0;
      font-family: "Trebuchet MS", "Segoe UI", sans-serif;
      background-image: linear-gradient(to right top, #0d1726, #032434, #00323d, #003f40, #134c3d);
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1b1f24;
    }
    .register-container {
      background: #fff;
      padding: 40px;
      border-radius: 14px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
      width: 100%;
      max-width: 400px;
    }
    .register-container h2 {
      margin-top: 0;
      color: #0b6b5d;
    }
    .field {
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field label {
      font-weight: 600;
    }
    .field input, .field select {
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid #d7dde2;
      font-family: inherit;
    }
    .button {
      background: #0b6b5d;
      color: #fff;
      border: none;
      padding: 12px;
      border-radius: 999px;
      width: 100%;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .button:hover {
      background: #085247;
    }
    #error-msg {
      color: #b91c1c;
      background: #fee2e2;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 16px;
      display: none;
      font-weight: 600;
      font-size: 14px;
    }
    #success-msg {
      color: #15803d;
      background: #dcfce7;
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 16px;
      display: none;
      font-weight: 600;
      font-size: 14px;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body>
  <div class="register-container">
    <h2>Criar Conta</h2>
    <div id="error-msg"></div>
    <div id="success-msg"></div>
    
    <form id="register-form">
      <div class="field">
        <label for="nome">Nome Completo</label>
        <input type="text" id="nome" required placeholder="Ex: João Silva" />
      </div>
      <div class="field">
        <label for="email">E-mail</label>
        <input type="email" id="email" required placeholder="nome@empresa.com" />
      </div>
      <div class="field">
        <label for="senha">Senha</label>
        <input type="password" id="senha" required minlength="6" placeholder="Mínimo 6 caracteres" />
      </div>
      <div class="field">
        <label for="papel">Nível de Acesso (Papel)</label>
        <select id="papel">
          <option value="OPERADOR" selected>Operador de Campo</option>
          <option value="GESTOR">Gestor de Operações</option>
        </select>
      </div>
      <button type="submit" class="button">Cadastrar Sistema</button>
      
      <div style="text-align: center; margin-top: 15px; font-size: 14px;">
        <span>Já tem uma conta? <a href="/login" style="color: #0b6b5d; font-weight: 600; text-decoration: none;">Faça Login</a></span>
      </div>
    </form>
  </div>

  <script>
    document.getElementById('register-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const nome = document.getElementById('nome').value;
      const email = document.getElementById('email').value;
      const senha = document.getElementById('senha').value;
      const papel = document.getElementById('papel').value;
      
      const errorMsg = document.getElementById('error-msg');
      const successMsg = document.getElementById('success-msg');
      
      errorMsg.style.display = 'none';
      successMsg.style.display = 'none';
      
      try {
        await axios.post('/api/auth/registrar', { nome, email, senha, papel });
        
        successMsg.textContent = 'Usuário cadastrado com sucesso! Redirecionando...';
        successMsg.style.display = 'block';
        
        setTimeout(() => {
          window.location.href = '/login';
        }, 2000);
        
      } catch (error) {
        errorMsg.textContent = error.response?.data?.erro || 'Erro ao processar cadastro de usuário.';
        errorMsg.style.display = 'block';
      }
    });
  </script>
</body>
</html>