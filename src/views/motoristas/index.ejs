<div class="page-title">
  <h1>Motoristas</h1>
  <a class="button" href="/painel/motoristas/novo">Novo motorista</a>
</div>

<div class="card">
  <% if (!motoristas.length) { %>
    <p>Nenhum motorista cadastrado.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>CPF</th>
          <th>Placa</th>
          <th>Status</th>
          <th>Acoes</th>
        </tr>
      </thead>
      <tbody>
        <% motoristas.forEach((motorista) => { %>
          <tr>
            <td><%= motorista.nome %></td>
            <td><%= motorista.cpf %></td>
            <td><%= motorista.placaVeiculo %></td>
            <td><span class="badge badge--<%= motorista.status %>"><%= motorista.status %></span></td>
            <td>
              <% if (motorista.status === "ATIVO") { %>
                <form method="POST" action="/painel/motoristas/<%= motorista.id %>/inativar" style="display:inline;">
                  <button class="button button--danger" type="submit">Inativar</button>
                </form>
              <% } else { %>
                <form method="POST" action="/painel/motoristas/<%= motorista.id %>/ativar" style="display:inline;">
                  <button class="button" type="submit">Ativar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
